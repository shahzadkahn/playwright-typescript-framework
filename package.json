{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "End-to-end UI and API test automation framework built with Playwright and TypeScript, using the Page Object Model, custom fixtures, CI on GitHub Actions and Allure reporting.",
  "author": "Shahzad Zaman Khan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "report:html": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
