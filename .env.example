# Copy to .env and adjust. .env is git-ignored.

# Which environment from config/environments.ts to use: demo or staging
TEST_ENV=demo

# Optional overrides for a different deployment
UI_BASE_URL=
API_BASE_URL=

# Demo credentials (public on the demo sites; real projects keep these in secrets)
SAUCE_PASSWORD=secret_sauce
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
